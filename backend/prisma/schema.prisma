// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ProductCategory {
  ELECTRONICS
  HARDWARE
  OFFICE
  OTHER
}

enum StockMovementType {
  IN
  OUT
}

enum SalesChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model User {
  id                String             @id @default(cuid())
  name              String             @db.VarChar(120)
  email             String             @unique @db.VarChar(320)
  password          String
  role              UserRole           @default(EMPLOYEE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdCustomers  Customer[]         @relation("CustomerCreatedBy")
  customerFollowUps CustomerFollowUp[] @relation("FollowUpCreatedBy")
  stockMovements    StockMovement[]    @relation("StockMovementCreatedBy")
  salesChallans     SalesChallan[]     @relation("SalesChallanCreatedBy")

  @@index([role])
  @@index([createdAt])
}

model Customer {
  id            String             @id @default(cuid())
  businessName  String             @db.VarChar(200)
  contactPerson String             @db.VarChar(120)
  email         String?            @db.VarChar(320)
  phone         String?            @db.VarChar(30)
  gstNumber     String?            @db.VarChar(15)
  address       String?            @db.Text
  status        CustomerStatus     @default(ACTIVE)
  createdById   String
  createdBy     User               @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  followUps     CustomerFollowUp[]
  salesChallans SalesChallan[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([businessName])
  @@index([contactPerson])
  @@index([businessName, contactPerson])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([createdById])
}

model CustomerFollowUp {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  note         String    @db.Text
  followUpDate DateTime?
  createdById  String
  createdBy    User      @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime  @default(now())

  @@index([customerId, followUpDate])
  @@index([followUpDate])
  @@index([createdById])
}

model Product {
  id             String             @id @default(cuid())
  name           String             @db.VarChar(200)
  sku            String             @unique @db.VarChar(100)
  description    String?            @db.Text
  category       ProductCategory?
  unitPrice      Decimal            @db.Decimal(12, 2)
  currentStock   Int                @default(0)
  minimumStock   Int                @default(0)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  stockMovements StockMovement[]
  challanItems   SalesChallanItem[]

  @@index([name])
  @@index([category])
  @@index([currentStock])
  @@index([isActive])
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quantity    Int
  type        StockMovementType
  reason      String?           @db.VarChar(255)
  createdById String
  createdBy   User              @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([type])
  @@index([createdById])
}

model SalesChallan {
  id            String             @id @default(cuid())
  challanNumber String             @unique @db.VarChar(50)
  customerId    String
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  totalAmount   Decimal            @db.Decimal(12, 2)
  status        SalesChallanStatus @default(DRAFT)
  createdById   String
  createdBy     User               @relation("SalesChallanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items         SalesChallanItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

model SalesChallanItem {
  id          String       @id @default(cuid())
  challanId   String
  challan     SalesChallan @relation(fields: [challanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productName String       @db.VarChar(200)
  sku         String       @db.VarChar(100)
  unitPrice   Decimal      @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal      @db.Decimal(12, 2)

  @@index([challanId])
  @@index([productId])
}
